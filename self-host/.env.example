# Copy to .env in this folder. Shared by the app and scanner containers
# (self-host/docker-compose.yml's env_file: .env on both services).

# From self-host/supabase — the gateway container (api-gw) is aliased as
# "kong" on homelab-network, so this resolves regardless of which gateway
# Supabase ships by default (see supabase/README.md step 5).
SUPABASE_URL=http://kong:8000
SUPABASE_SERVICE_KEY=

# How the app reaches the scanner container, over the compose network.
SCANNER_URL=http://scanner:9100
SCANNER_PORT=9100

# --- AI provider (pick ONE, see ai_provider.py) ---
AI_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
EMBED_MODEL=
AI_PREFILTER_SEND_ALL_MAX=
AI_PREFILTER_TOP_N=

# Optional. Get one at https://firecrawl.dev
FIRECRAWL_API_KEY=

# Optional — only needed if any site is configured with "Requires login".
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# Cosmetic (dashboard text) + the scanner's actual daily cron time — keep
# these in sync, they're read from the same variable in both containers.
DISPLAY_SCHEDULE_UTC=07:00 UTC
