# Local testing only. In production (self-hosted Docker), these live in
# self-host/.env instead — see self-host/README.md. This file is just for
# running `python scraper.py` or `python api/index.py` directly on your
# own machine outside Docker.

# Required everywhere. From Supabase: Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- AI provider (pick ONE, see ai_provider.py) ---
# AI_PROVIDER selects which one is used. Leave blank and it auto-picks
# whichever key below is present (checked in this order: anthropic, gemini).
AI_PROVIDER=

# Anthropic (Claude) — https://console.anthropic.com — pay-as-you-go, no free tier
ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com — has a free tier (rate-limited),
# BUT Google may use free-tier prompts/responses to improve their products.
# Worth weighing if scanned documents are commercially sensitive.
GEMINI_API_KEY=
# Optional — override the Gemini model. Google retires names often; the
# ai_provider.py default (gemini-3.6-flash) may need bumping to a newer 3.x.
GEMINI_MODEL=
# Optional — embedding model + semantic pre-filter tuning (see README).
# The pre-filter needs GEMINI_API_KEY even when AI_PROVIDER=anthropic.
EMBED_MODEL=
AI_PREFILTER_SEND_ALL_MAX=
AI_PREFILTER_TOP_N=

# Optional. Get one at https://firecrawl.dev
FIRECRAWL_API_KEY=

# Optional — only needed if any site is configured with "Requires login".
# Encrypts/decrypts a site's saved password (used by both api/index.py and
# scraper.py, so must be the same value in both places). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# Only needed for api/index.py's "Run Now"/"Cancel scan" buttons — the base
# URL of scanner_service.py. Running api/index.py directly like this (outside
# Docker), you'd normally run scanner_service.py separately too and point
# this at it, e.g. http://localhost:9100.
SCANNER_URL=

# Cosmetic (dashboard text) + the scanner's actual daily cron time.
DISPLAY_SCHEDULE_UTC=07:00 UTC
