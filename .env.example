# Local testing only. In production, these live as:
#   - GitHub Actions secrets (Settings > Secrets and variables > Actions) —
#     used by .github/workflows/daily-scan.yml / scraper.py
#   - Vercel environment variables (Project > Settings > Environment Variables) —
#     used by api/index.py
# This file is never deployed anywhere; it's just for `python scraper.py`
# or `python api/index.py` on your own machine.

# Required everywhere. From Supabase: Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- AI provider (pick ONE, see ai_provider.py) ---
# AI_PROVIDER selects which one is used. Leave blank and it auto-picks
# whichever key below is present (checked in this order: anthropic, gemini).
AI_PROVIDER=

# Anthropic (Claude) — https://console.anthropic.com — pay-as-you-go, no free tier
ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com — has a free tier (rate-limited),
# BUT Google may use free-tier prompts/responses to improve their products.
# Worth weighing if scanned documents are commercially sensitive.
GEMINI_API_KEY=
# Optional — override the Gemini model. Google retires names often; the
# ai_provider.py default (gemini-3.6-flash) may need bumping to a newer 3.x.
GEMINI_MODEL=

# Optional. Get one at https://firecrawl.dev
FIRECRAWL_API_KEY=

# Only needed for api/index.py's "Run Now" button (triggers the GitHub
# Actions workflow). A GitHub Personal Access Token with "repo" and
# "workflow" scope. See README.md for how to create one.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WORKFLOW_FILE=daily-scan.yml
GITHUB_REF=main

# Optional, purely cosmetic — shown on the dashboard as "runs daily around X".
DISPLAY_SCHEDULE_UTC=08:00 UTC
